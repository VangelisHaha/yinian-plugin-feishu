{
  "manifestVersion": 1,
  "id": "yinian-feishu",
  "name": "飞书",
  "version": "0.4.0",
  "author": "vangelis",
  "description": "把飞书任务与日历（含会议）同步进一念，并把一念的提醒发成飞书卡片",
  "homepage": "https://github.com/VangelisHaha/yinian-plugin-feishu",
  "minHostVersion": "0.12.0",
  "runtime": {
    "kind": "process",
    "node": ">=20",
    "entry": {
      "default": "dist/main.mjs"
    }
  },
  "permissions": {
    "net": [
      "open.feishu.cn",
      "accounts.feishu.cn",
      "open.larksuite.com",
      "accounts.larksuite.com"
    ],
    "spawn": ["/bin/ps"],
    "fs": [],
    "api": []
  },
  "contributes": {
    "sync": {
      "resources": ["task", "event"],
      "capabilities": {
        "actions": ["list", "get", "update", "complete", "reopen"],
        "fields": ["title", "notes", "due_at"]
      }
    },
    "syncStrategy": {
      "modes": ["interval", "manual"],
      "defaultIntervalSeconds": 60,
      "minIntervalSeconds": 60
    },
    "notificationChannel": {
      "id": "feishu",
      "name": "飞书",
      "supportsActions": false
    },
    "hooks": [],
    "settingsPanel": ["settings.plugin.json", "settings.integration.json"]
  },
  "authMode": ["oauth-device"]
}
